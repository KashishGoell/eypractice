[Unit]
Description=Carepoint Streamlit dashboard
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/eypractice
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/azureuser/eypractice/.venv/bin/streamlit run app.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
